# Run node cli.mjs setup for unique local credentials. No AI API key needed.
APP_STAGE=review
HOST=127.0.0.1
PORT=4330
PUBLIC_ORIGIN=http://127.0.0.1:4330
DATA_DIR=data
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Set only after actual owner approval and completed checks.
OWNER_APPROVED=false
LEGAL_APPROVED=false
MAIL_DELIVERY_TESTED=false
SEARCH_CONSOLE_READY=false
EXTERNAL_MONITOR_READY=false
OFFSITE_BACKUP_READY=false
# Only use behind one trusted reverse proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
# Optional production email delivery (never used in review mode).
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=
